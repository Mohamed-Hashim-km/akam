// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  READER
  AUTHOR
  EDITOR
  ADMIN
}

enum StoryStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  STORY_SUBMITTED
  STORY_APPROVED
  STORY_REJECTED
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String?
  bio         String?
  avatarUrl   String?
  role        Role     @default(READER)
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stories       Story[]
  notifications Notification[]
}

model OtpCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model Story {
  id            String      @id @default(uuid())
  title         String
  slug          String      @unique
  content       String      @db.Text
  coverImageUrl String?
  status        StoryStatus @default(DRAFT)
  rejectionNote String?
  authorId      String
  author        User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  notifications Notification[]

  @@index([status])
  @@index([authorId])
}

model Notification {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           NotificationType
  message        String
  read           Boolean          @default(false)
  relatedStoryId String?
  relatedStory   Story?           @relation(fields: [relatedStoryId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())

  @@index([userId])
  @@index([read])
}

model StoryBookmark {
  id        String   @id @default(uuid())
  userId    String
  storyId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
  @@map("story_bookmark")
}

model StoryLike {
  id        String   @id @default(uuid())
  userId    String
  storyId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
  @@map("story_like")
}

model StoryComment {
  id        String   @id @default(uuid())
  userId    String
  storyId   String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  story   Story         @relation(fields: [storyId], references: [id], onDelete: Cascade)
  reports StoryReport[]

  @@map("story_comment")
}

model StoryReport {
  id         String   @id @default(uuid())
  storyId    String?
  commentId  String?
  reporterId String
  reason     String
  details    String?
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  story    Story?        @relation(fields: [storyId], references: [id], onDelete: Cascade)
  comment  StoryComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter User          @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@map("story_report")
}

model ReadingProgress {
  id                 String   @id @default(uuid())
  userId             String
  storyId            String
  progressPercent    Int      @default(0)
  lastScrollPosition Int      @default(0)
  isCompleted        Boolean  @default(false)
  lastReadAt         DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
  @@map("reading_progress")
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_setting")
}

// ─── COMMUNITY PLATFORM ──────────────────────────────────────────────────────

enum PostStatus {
  ACTIVE
  LOCKED
  REMOVED
  PINNED
}

enum VoteValue {
  UP
  DOWN
}

enum CommunityMemberRole {
  MEMBER
  MODERATOR
}

enum PostFlair {
  DISCUSSION
  QUESTION
  ANNOUNCEMENT
  RESOURCE
  FEEDBACK
}

model Community {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  bannerUrl   String?
  iconUrl     String?
  color       String?
  isActive    Boolean  @default(true)
  memberCount Int      @default(0)
  postCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships CommunityMembership[]
  posts       CommunityPost[]

  @@index([slug])
  @@index([isActive])
  @@map("community")
}

model CommunityMembership {
  id          String              @id @default(uuid())
  userId      String
  communityId String
  role        CommunityMemberRole @default(MEMBER)
  joinedAt    DateTime            @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([communityId])
  @@index([userId])
  @@map("community_membership")
}

model CommunityPost {
  id           String     @id @default(uuid())
  communityId  String
  authorId     String
  title        String
  body         String?    @db.Text
  imageUrl     String?
  linkUrl      String?
  flair        PostFlair  @default(DISCUSSION)
  status       PostStatus @default(ACTIVE)
  upvotes      Int        @default(0)
  downvotes    Int        @default(0)
  commentCount Int        @default(0)
  isPinned     Boolean    @default(false)
  isLocked     Boolean    @default(false)
  lockedAt     DateTime?
  lockedById   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  community Community  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author    User       @relation("CommunityPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  lockedBy  User?      @relation("CommunityPostLocker", fields: [lockedById], references: [id], onDelete: SetNull)

  comments CommunityComment[]
  votes    PostVote[]
  reports  CommunityReport[]

  @@index([communityId, status])
  @@index([authorId])
  @@index([createdAt])
  @@map("community_post")
}

model CommunityComment {
  id          String   @id @default(uuid())
  postId      String
  authorId    String
  parentId    String?
  body        String   @db.Text
  depth       Int      @default(0)
  upvotes     Int      @default(0)
  downvotes   Int      @default(0)
  isRemoved   Boolean  @default(false)
  removedById String?
  removedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  post      CommunityPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User               @relation("CommunityCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent    CommunityComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   CommunityComment[] @relation("CommentReplies")
  removedBy User?              @relation("CommentRemover", fields: [removedById], references: [id], onDelete: SetNull)

  votes   CommentVote[]
  reports CommunityReport[]

  @@index([postId, parentId])
  @@index([authorId])
  @@map("community_comment")
}

model PostVote {
  id        String    @id @default(uuid())
  userId    String
  postId    String
  value     VoteValue
  createdAt DateTime  @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("post_vote")
}

model CommentVote {
  id        String    @id @default(uuid())
  userId    String
  commentId String
  value     VoteValue
  createdAt DateTime  @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment CommunityComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@map("comment_vote")
}

model CommunityReport {
  id           String    @id @default(uuid())
  postId       String?
  commentId    String?
  reporterId   String
  reason       String
  details      String?   @db.Text
  status       String    @default("PENDING")
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  post       CommunityPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment    CommunityComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter   User              @relation("CommunityReportSubmitter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy User?             @relation("CommunityReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([postId])
  @@map("community_report")
}

// ─── EVENTS PLATFORM ─────────────────────────────────────────────────────────

enum EventType {
  READING_SESSION
  DISCUSSION
  WORKSHOP
  PAST_ARCHIVE
}

model Event {
  id           String    @id @default(uuid())
  type         EventType @default(READING_SESSION)
  title        String
  description  String    @db.Text
  location     String
  time         String?
  day          String?
  monthYear    String?
  eventDate    DateTime?
  imageSrc     String?
  registerHref String?
  isPublished  Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

// ─── BOOK RELEASES PLATFORM ───────────────────────────────────────────────────

model BookRelease {
  id           String   @id @default(uuid())
  title        String
  author       String
  editionTag   String?  @default("Print Edition")
  description  String   @db.Text
  coverImage   String?
  preorderLink String?
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished])
  @@map("book_release")
}

// ─── PREVIOUS EDITIONS PLATFORM ───────────────────────────────────────────────

model Edition {
  id          String   @id @default(uuid())
  title       String
  pdfUrl      String
  coverImage  String?
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
  @@map("edition")
}

// ─── MEDIA SHOWCASE PLATFORM ──────────────────────────────────────────────────

model MediaVideo {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  category    String   // 'interviews' | 'conversations' | 'cultural' | 'recordings'
  youtubeUrl  String
  youtubeId   String
  isPublished Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, isPublished])
  @@index([isFeatured, isPublished])
  @@map("media_video")
}

